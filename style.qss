
QWidget {
    background-color: white;
    font-family: Arial;
    font-size: 14px;
}

QLabel {
    color: darkslategray;
}

QLabel#mainTitle {
    font-size: 24px;
    font-weight: bold;
    color: darkblue;
    padding: 10px;
}

QPushButton {
    background-color: darkblue;
    color: white;
    padding: 12px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: steelblue;
}

QCheckBox {
    color: darkblue;
    font-weight: bold;
    padding: 10px;
    border: 1px solid lightgray;
    border-radius: 6px;
    background-color: aliceblue;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid darkblue;
    border-radius: 4px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: royalblue;
    border: 2px solid darkblue;
}
