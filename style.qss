
QWidget {
    background-color: white;
    font-family: Arial;
    font-size: 14px;
}

QLabel {
    color: darkslategray;
}

QLabel#mainTitle {
    font-size: 24px;
    font-weight: bold;
    color: darkblue;
    padding: 10px;
}

QPushButton {
    background-color: darkblue;
    color: white;
    padding: 12px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: steelblue;
}
